{
  "name": "sierrafy",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source identity verification SDK for Sierra Leone (monorepo root)",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "docs:dev": "pnpm --filter @sierrafy/website start",
    "docs:build": "pnpm --filter @sierrafy/website build",
    "docs:serve": "pnpm --filter @sierrafy/website serve",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "check:pii": "node scripts/check-sample-pii.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0"
  }
}
